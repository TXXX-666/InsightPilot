# OpenAI-compatible model API (relay services are supported)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Required for real-time web search
TAVILY_API_KEY=

# Optional hosted MCP endpoints. Treat these URLs as secrets; do not commit them.
MODELSCOPE_TAVILY_MCP_URL=
MODELSCOPE_ARXIV_MCP_URL=

# Optional external notification channel. Sending is always approval-gated.
FEISHU_WEBHOOK_URL=

# Runtime
INSIGHTPILOT_DB_PATH=./data/insightpilot.db
INSIGHTPILOT_API_URL=http://127.0.0.1:8000
# 部署到局域网或公网时必须配置；前端和后端使用同一个值。
INSIGHTPILOT_API_TOKEN=
INSIGHTPILOT_HOST=127.0.0.1
INSIGHTPILOT_PORT=8000
INSIGHTPILOT_WORKERS=2
INSIGHTPILOT_MAX_SEARCH_RESULTS=8
INSIGHTPILOT_FETCH_CONCURRENCY=5
INSIGHTPILOT_PROVIDER_RETRIES=3
INSIGHTPILOT_JSON_RETRIES=2
INSIGHTPILOT_JSON_MAX_TOKENS=4096
INSIGHTPILOT_JSON_RETRY_MAX_TOKENS=8192
# Multi-Agent state machine limits and quality gates
INSIGHTPILOT_AGENT_RETRIES=2
INSIGHTPILOT_VERIFIER_BATCH_SIZE=3
INSIGHTPILOT_MAX_VERIFICATION_EVIDENCE=24
INSIGHTPILOT_MAX_AGENT_STEPS=30
INSIGHTPILOT_MAX_SEARCH_ROUNDS=3
INSIGHTPILOT_MAX_REVISION_ROUNDS=2
INSIGHTPILOT_MIN_EVIDENCE_COVERAGE=0.72
INSIGHTPILOT_MIN_VERIFIED_CLAIMS=3
INSIGHTPILOT_MIN_UNIQUE_SOURCES=3
# Includes the model's internal reasoning tokens. Increase for reasoning models that write long reports.
INSIGHTPILOT_REPORT_MAX_TOKENS=8192
INSIGHTPILOT_LOG_LEVEL=INFO
